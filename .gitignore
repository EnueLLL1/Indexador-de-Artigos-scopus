```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
*.js.map

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs and temp files
*.log
*.tmp

# Python (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
.venv.bak/
.env.bak/
.mypy_cache/
.pytest_cache/
.coverage
coverage/
htmlcov/

# Compiled and binary files
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# OS specific
.DS_Store
Thumbs.db

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```